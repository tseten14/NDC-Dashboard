{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/prepare-vercel-public.mjs",
  "installCommand": "npm install",
  "framework": null,
  "env": {
    "USE_MOCK_DATA": "false"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{database/**,backend/lib/**,backend/server/**,backend/services/**,backend/routes/**,data/policy/**,data/policy-cases/**,config/**,shared/**}"
    }
  }
}
