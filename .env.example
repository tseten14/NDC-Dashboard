# Copy to .env and fill in. NEVER commit .env — see SECURITY.md.
#
# Two kinds of variable live in this file, and the difference matters:
#
#   VITE_*   are compiled into the JavaScript sent to every visitor's browser.
#            Treat their values as public. Anyone can read them in the page
#            source. Never put a password, key or token behind a VITE_ prefix.
#
#   everything else is server-side only and never reaches the browser.
#
# ── Local development ─────────────────────────────────────────────────────────
# VITE_API_BASE_URL is optional in dev: Vite proxies /api → API_PORT (see
# frontend/vite.config.ts). Leave unset to use same-origin /api/v1.
# VITE_API_BASE_URL=http://localhost:8787
API_PORT=8787
USE_MOCK_DATA=false

# ── Which sites may call this API from a browser ──────────────────────────────
# Must match the address the app is served from. Several may be listed,
# comma-separated, for a custom domain plus a preview URL. Anything not listed
# is refused. On Vercel the deployment's own hostnames are added automatically.
FRONTEND_ORIGIN=http://localhost:8080

# ── Operator passphrase for the import screens ────────────────────────────────
# SERVER-SIDE ONLY. Guards every endpoint that writes data.
#
# Two ways to present it:
#   - a person types it into the unlock box on the import screen, and the server
#     returns a session cookie the browser's JavaScript cannot read;
#   - a script sends it directly as the header  x-api-key: <value>
#
# Use a long random value in production, e.g.  openssl rand -base64 32
# There is deliberately no VITE_ mirror of this: an earlier version had one,
# which compiled the passphrase into the public bundle and made it worthless.
INGEST_API_KEY=dev-ingest-key-change-me

# Signs operator session cookies. Optional — derived from INGEST_API_KEY when
# unset. Set it explicitly in production so that rotating one does not
# invalidate the other. Generate with:  openssl rand -base64 32
# SESSION_SECRET=

# ── AI features ───────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Used by the NDC dashboard assistant and policy analysis.
# These endpoints are public and rate-limited; leave unset to switch them off.
OPENAI_API_KEY=
# Optional override (default: gpt-5.6-sol)
# OPENAI_MODEL=gpt-5.6-sol

# ── Logging ───────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info

# ── Postgres (Drizzle ORM) ────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Grant this user only the rights the app needs — see the
# "Database security" section of SECURITY.md for the exact GRANT statements.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ndc_explorer
# Encryption for the database connection. Required automatically for any
# non-localhost host. Values: require | no-verify | disable
# DATABASE_SSL=require
# DATABASE_POOL_MAX=5

# Seeding writes reference data. Keep false in production — leaving it on means
# every deploy re-runs the seed against the live database.
SEED_DB=false
# Serve bundled reference data when Postgres is unreachable instead of failing.
USE_DB_FALLBACK=true

# ── Deployment ────────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the API. Rate limiting counts callers by
# IP and reads it from X-Forwarded-For; too high a value lets a caller forge the
# header and evade the limit. Vercel sets this to 1 automatically.
# TRUST_PROXY_HOPS=0

# How long to wait for Climate TRACE before giving up (milliseconds).
# CLIMATE_TRACE_TIMEOUT_MS=15000

# Overrides where fallback ingest data is written (used by tests).
# INGEST_STORE_PATH=
