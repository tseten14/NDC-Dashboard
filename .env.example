# Copy to .env and fill from Supabase: Project Settings → API → API Keys
# Use the publishable key (sb_publishable_...) or legacy anon public (eyJ...).

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Server + seed scripts (never expose service role to the browser)
# SUPABASE_URL can match VITE_SUPABASE_URL
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"
API_PORT=8787
USE_MOCK_DATA=false
