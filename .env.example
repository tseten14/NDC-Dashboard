# Local development
# VITE_API_BASE_URL is optional in dev: Vite proxies /api → API_PORT (see frontend/vite.config.ts).
# Leave unset to use same-origin /api/v1 from the browser.
# VITE_API_BASE_URL=http://localhost:8787
API_PORT=8787
USE_MOCK_DATA=false

# Frontend origin allowed by CORS (must match Vite dev server or production URL)
FRONTEND_ORIGIN=http://localhost:8080

# Shared secret for ingest write endpoints (POST /api/v1/ingest/*)
# Send as header: x-api-key: <INGEST_API_KEY>
INGEST_API_KEY=dev-ingest-key-change-me

# Mirror for the Vite frontend when calling write endpoints from the browser
VITE_INGEST_API_KEY=dev-ingest-key-change-me

# OpenAI API key — required for NDC AI dashboard panel and Policy AI analysis
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
# Optional override (default: gpt-5.6-sol — OpenAI flagship)
# OPENAI_MODEL=gpt-5.6-sol

# Google Gemini API key (optional legacy)
GEMINI_API_KEY=AIzaSy...

# Log level for pino (trace | debug | info | warn | error)
LOG_LEVEL=info

# Postgres (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ndc_explorer
SEED_DB=false
USE_DB_FALLBACK=true

# Vercel production: leave VITE_API_BASE_URL unset (same-origin /api/v1).
# Set FRONTEND_ORIGIN to your deployed app URL (e.g. https://your-app.vercel.app).
# See docs/DEPLOY-VERCEL.md
