# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
scripts/.verify-predictions-*
dist
dist-ssr
*.local

# Secrets.
#
# Ignore every .env variant and then re-admit the example, rather than listing
# the variants individually — the previous list covered .env and .env.local but
# not .env.production or .env.staging, which are exactly the files that hold
# real credentials.
.env
.env.*
!.env.example

# Credential files that must never be committed under any name.
*.pem
*.key
*.p12
*.pfx
id_rsa*
secrets.json
credentials.json
service-account*.json
gha-creds-*.json

# Database dumps — these routinely contain production data.
*.sql.gz
*.dump
dump.rdb

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
public

# Local ingest staging (created by API confirm flow)
data/ingest-imports/
data/ingest-observations.json

# Python bytecode cache (ingest analysis scripts)
__pycache__/
*.pyc

# Local SQLite databases (dev/test)
backend/*.db

# Playwright / test runner output
test-results/

# TypeScript compiler output log
.tsc-output.txt
